{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon --ignore prisma/seeds/ --ignore temp_seeds/ --ignore backups/ src/index.ts",
        "build": "npx prisma generate && tsc",
        "start": "node dist/src/index.js",
        "seed": "prisma db seed",
        "export": "ts-node src/export-cli.ts",
        "data:weapon-game-data": "ts-node scripts/generate/weaponGameData.ts",
        "sync-assets": "ts-node scripts/sync-assets.ts",
        "sync:assets": "ts-node scripts/sync-assets.ts --sync",
        "sync:assets:check": "ts-node scripts/sync-assets.ts",
        "sync:version": "node scripts/sync/check-version.cjs",
        "test:sync:version": "node --test scripts/sync/check-version.test.cjs",
        "sync:check": "ts-node scripts/sync/syncEngine.ts --dry-run",
        "sync:run": "ts-node scripts/sync/syncEngine.ts --sync --download-assets --publish-assets",
        "sync:validate": "ts-node scripts/sync/syncEngine.ts --validate --dry-run",
        "sync:rollback": "ts-node scripts/sync/syncEngine.ts --rollback",
        "sync:mats:check": "ts-node scripts/sync/materialBackfill.ts --dry-run --validate",
        "sync:mats:verify": "ts-node scripts/sync/materialBackfill.ts --verify --validate",
        "sync:mats:apply": "ts-node scripts/sync/materialBackfill.ts --sync --validate",
        "sync:mats:rollback": "ts-node scripts/sync/materialBackfill.ts --rollback",
        "sync:e2e": "ts-node scripts/sync/e2e.test.ts",
        "sync:staging": "ts-node scripts/staging/syncFromLocal.ts",
        "test:assets": "ts-node scripts/sync/asset.test.ts",
        "test:mats": "ts-node scripts/sync/materialBackfill.test.ts",
        "test:auth": "node -r ts-node/register --test src/auth/security.test.ts src/auth/auth.service.integration.test.ts src/services/mailer.service.test.ts",
        "test:storage": "node -r ts-node/register --test src/utils/objectStorage.test.ts src/auth/adminHttp.test.ts scripts/backup/backupArtifact.test.ts",
        "backup:verify-db": "ts-node scripts/backup/verifyStagingDatabase.ts",
        "backup:upload": "ts-node scripts/backup/uploadBackup.ts",
        "auth:bootstrap-admin": "ts-node src/auth/bootstrap-admin.ts",
        "seed:ci": "ts-node prisma/seed-ci.ts"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@aws-sdk/client-s3": "3.984.0",
        "@google/generative-ai": "^0.24.1",
        "@graphql-tools/merge": "^9.1.10",
        "@graphql-tools/schema": "^10.0.34",
        "@prisma/client": "^5.10.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/nodemailer": "^8.0.1",
        "axios": "^1.18.1",
        "axios-retry": "^4.5.0",
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dataloader": "^2.2.3",
        "dotenv": "^17.4.2",
        "enka-network-api": "^5.0.15",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "genshin-db": "5.2.15",
        "graphql": "^16.14.1",
        "graphql-type-json": "^0.3.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "lru-cache": "^11.5.1",
        "multer": "^2.1.1",
        "nodemailer": "^9.0.3",
        "semver": "7.8.6",
        "sharp": "^0.35.2",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261124.1",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.9.3",
        "nodemon": "^3.1.14",
        "prisma": "^5.10.0",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "wrangler": "^4.167.0"
    }
}
