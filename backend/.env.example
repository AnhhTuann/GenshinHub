DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/genshinhub"
# DIRECT_URL: dùng cho pg_dump/backup khi DATABASE_URL đi qua pooler (pgbouncer).
# DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/genshinhub"
# Authentication is DB-backed. Create the one-time owner out-of-band:
#   ADMIN_BOOTSTRAP_PASSWORD='<one-time secret>' npm run auth:bootstrap-admin -- --username owner
# ADMIN_BOOTSTRAP_PASSWORD is used only by that CLI and must not be kept in runtime env.
# ADMIN_JWT_SECRET, if present, is only an evidence HMAC key for review proofs.
FRONTEND_URL=http://localhost:3000
PORT=4000

# --- Asset storage (local/persistent, dev only) ---
# Thư mục gốc lưu asset đã tải. Mặc định: ../frontend/public (dev).
# On Render/Vercel do NOT set this: the filesystem is ephemeral.
# ASSET_STORAGE_PATH=/srv/genshinhub/assets
# ASSET_PUBLIC_URL=/assets

# --- Neon Object Storage (Render service env vars) ---
# Branch-scoped credentials from the Neon dashboard. Set these in Render,
# never in the repository. When all five are present, /upload stores WebP in
# ASSET_BUCKET and /assets/uploads/* reads it back through a controlled proxy.
# Without them, Render/Vercel fail closed and local dev uses the filesystem.
# AWS_ACCESS_KEY_ID=<Neon storage access key id>
# AWS_SECRET_ACCESS_KEY=<Neon storage secret access key>
# AWS_ENDPOINT_URL_S3=https://br-hidden-frost-aouh1xm1.storage.c-2.ap-southeast-1.aws.neon.tech
# AWS_REGION=ap-southeast-1
# ASSET_BUCKET=genshinhub-staging-assets

# BACKUP_BUCKET is used by .github/workflows/neon-pgdump.yml only. Configure it
# as a GitHub Actions repository secret, not as a browser-exposed variable.
# BACKUP_BUCKET=genshinhub-staging-backups

# Password reset mail (set all values before enabling delivery).
# Production FRONTEND_URL must be the public HTTPS origin.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=GenshinHub <noreply@example.com>
# Port 587 requires STARTTLS. For port 465, set SMTP_SECURE=true.
