# Cloudflare Workers Static Assets headers. Next.js headers() do not apply to
# static-asset responses, so catalogue caching is declared here instead.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/icon.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/logo.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
