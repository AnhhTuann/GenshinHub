{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{scripts/weapon-tier-independent/**,scripts/weapon-tier-audit/**,../docs/weapon-tier-independent/**,../docs/tierlist/phase-d2/**,../docs/weapon-tier-audit/PHASE_B2_6_FINAL_REVIEW.md}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
