# Names only — never commit real values. Copy to .env.local for local work.
# Production values live in Render / Vercel / GitHub Actions secret stores.

# ── Render service: genshinhub-api (backend) ─────────────────────────────────
DATABASE_URL=<Neon staging connection string, set in Render only>
FRONTEND_URL=https://genshinhub-staging.vercel.app
STATELESS_HOST=1

# Neon Object Storage credentials (branch-scoped; create in Neon dashboard).
# ASSET_BUCKET and BACKUP_BUCKET must be two separate private buckets.
AWS_ACCESS_KEY_ID=<Neon storage access key id>
AWS_SECRET_ACCESS_KEY=<Neon storage secret access key>
AWS_ENDPOINT_URL_S3=https://br-hidden-frost-aouh1xm1.storage.c-2.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1
ASSET_BUCKET=genshinhub-staging-assets
BACKUP_BUCKET=genshinhub-staging-backups

# ── GitHub Actions secrets: .github/workflows/neon-pgdump.yml ────────────────
# Same names as above are read from the repository secret store. These are NOT
# repository Variables and are never written to files or printed by the job.
# NEON_DATABASE_URL   = direct Neon staging connection string for pg_dump
# AWS_ACCESS_KEY_ID   = same storage key (needs read+write on backup bucket)
# AWS_SECRET_ACCESS_KEY
# AWS_ENDPOINT_URL_S3 = the path-style S3 endpoint above
# AWS_REGION          = ap-southeast-1
# BACKUP_BUCKET       = genshinhub-staging-backups

# ── Vercel project: genshinhub-staging (frontend, server-side only) ──────────
NEXT_PUBLIC_GRAPHQL_URL=https://genshinhub-api.onrender.com/graphql
BACKEND_URL=https://genshinhub-api.onrender.com
REVALIDATE_SECRET=<set in Vercel and GitHub Actions>
FRONTEND_REVALIDATE_URL=https://genshinhub-staging.vercel.app
