{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging worker only. Production keeps its own reviewed deployment later.
  "name": "genshinhub-frontend-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext self-reference. Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "genshinhub-frontend-staging"
    }
  ],
  // Free Workers KV namespaces replace R2 because R2 is not enabled on this
  // account and must not be activated without explicit approval.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "b68fde2cd0cb4a0aaa47423907a40ae7" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "abc5b36dd1f1496f82a643c70e8571fb" }
  ],
  "vars": {
    "NODE_ENV": "production",
    "NEXT_INC_CACHE_KV_PREFIX": "genshinhub-staging",
    "BACKEND_URL": "https://genshinhub-api.onrender.com",
    "NEXT_PUBLIC_GRAPHQL_URL": "https://genshinhub-api.onrender.com/graphql"
  },
  "observability": { "enabled": true }
}
