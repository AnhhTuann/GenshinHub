DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/genshinhub"
# DIRECT_URL: dùng cho pg_dump/backup khi DATABASE_URL đi qua pooler (pgbouncer).
# DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/genshinhub"
ADMIN_PASSWORD=your_admin_password_here
FRONTEND_URL=http://localhost:3000
PORT=4000

# --- Asset storage (local/persistent) ---
# Thư mục gốc lưu asset đã tải. Mặc định: ../frontend/public (dev).
# Trên VPS nên trỏ ra ngoài source code, vd: /srv/genshinhub/assets
# ASSET_STORAGE_PATH=/srv/genshinhub/assets
# URL public của assets (nếu CDN/reverse proxy khác domain)
# ASSET_PUBLIC_URL=/assets
