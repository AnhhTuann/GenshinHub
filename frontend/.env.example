NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# Server-side backend URL for Next.js route handlers (do not expose secrets publicly)
BACKEND_URL=http://localhost:4000
# Optional: Vercel Deployment Protection bypass secret for server-to-server calls only.
# Set in Vercel project env (server-side) and matching backend deployment protection config.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Social Login
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here

# --- Asset storage (persistent, optional) ---
# Khi backend sync assets ra ngoài frontend/public (vd VPS), route
# app/assets/[...path] sẽ phục vụ file từ thư mục này.
# ASSET_STORAGE_PATH=/srv/genshinhub/assets
# ASSET_PUBLIC_URL=/assets
